# Mole Whitelist - Protected paths won't be deleted
# Default protections: Playwright browsers, HuggingFace models, Maven repo, Ollama models, Surge Mac, R renv, Finder metadata
# Add one pattern per line to keep items safe.

# macOS
~/Library/Application Support/com.apple.wallpaper
~/Library/Caches/com.apple.finder
~/Library/Caches/CloudKit
~/Library/Mobile Documents

# Raycast
~/Library/Application Support/com.raycast.macos
~/Library/Application Support/com.raycast.shared

# Homebrew / mise / pnpm / uv
~/Library/Caches/Homebrew
~/.local/share/mise
~/.cache/mise
~/.local/share/pnpm/store
~/.cache/uv

# dev caches
~/.cache/pre-commit
~/.cache/pytest

# sheldon
~/.local/share/sheldon
~/.cache/sheldon

# chezmoi source
~/.local/share/chezmoi

# utils
~/.local/share/atuin
~/.local/state/atuin

# astro nvim
~/.local/share/nvim
~/.local/state/nvim
~/.cache/nvim

# apps
~/Library/Application Support/Zed
~/Library/Application Support/Syncthing
~/Library/Application Support/obsidian

# mole
~/.config/mole
~/.cache/mole

